# Airflow
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:2.6.3

# PostgreSQL - metastore Airflow
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=change_me
POSTGRES_AIRFLOW_DB=airflow

# PostgreSQL - Data Warehouse
POSTGRES_DWH_USER=dwh_user
POSTGRES_DWH_PASSWORD=change_me
POSTGRES_DWH_DB=jobs_dwh

# API France Travail (https://francetravail.io/)
FRANCE_TRAVAIL_CLIENT_ID=your_client_id
FRANCE_TRAVAIL_CLIENT_SECRET=your_client_secret
